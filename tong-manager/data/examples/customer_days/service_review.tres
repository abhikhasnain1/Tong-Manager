[sub_resource type="Resource" id="Schedule"]
script = ExtResource("2")
id = &"service_review"
mode = 1
max_active = 2
timeout_reaction_seconds = 0.8
arrivals = Array[ExtResource("3")]([SubResource("Arrival_0"), SubResource("Arrival_1"), SubResource("Arrival_2"), SubResource("Arrival_3"), SubResource("Arrival_4"), SubResource("Arrival_5")])

[resource]
script = ExtResource("1")
customer_schedule = SubResource("Schedule")
starting_cash = 100
daily_water_ml = 3000.0
starting_inventory = {&"banana": 4, &"biscuits": 6, &"black_tea": 12, &"condensed_milk": 8, &"sugar": 12}
